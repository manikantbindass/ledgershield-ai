# Local simulator only. Load with uvicorn --env-file .env.
SIM_SEED=42
NODE_COUNT=6
VALIDATOR_COUNT=4
RECOVERY_MODE=observe_only
# Generate distinct tokens using python scripts/create_local_tokens.py.
# Empty tokens disable all mutations until configured. Never commit real values.
LEDGERSHIELD_OPERATOR_TOKEN=
LEDGERSHIELD_ADMIN_TOKEN=
# Generated local URL-safe secrets; do not commit real values.
POSTGRES_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
# Optional native archive. Run alembic upgrade head before enabling.
# DATABASE_URL=sqlite:///artifacts/ledger.db
